# Network
NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
FACILITATOR_URL=https://x402.org/facilitator
EXPLORER_URL=https://sepolia.basescan.org

# Backup facilitator (Coinbase CDP)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Wallets
PUBLISHER_WALLET_ADDRESS=
# Test-only publisher key generated by scripts/create_wallets.py (the demo uses MetaMask instead)
PUBLISHER_PRIVATE_KEY=
BUYER_PRIVATE_KEY_1=
BUYER_PRIVATE_KEY_2=
BUYER_PRIVATE_KEY_3=
BUYER_PRIVATE_KEY_4=

# Buyer limits
BUYER_BUDGET_USDC=5.00
BUYER_MAX_PER_TX_USDC=2.50
BUYER_APPROVAL_THRESHOLD_USDC=1.00
# Where the buyer agent starts: the publisher manifest
BUYER_MANIFEST_URL=http://localhost:8000/.well-known/ai-data.json
# Empty: /buyer/* only from this machine. Set: required as X-Owner-Token header (never in a NEXT_PUBLIC_ var)
BUYER_OWNER_TOKEN=

# Gateway
# Empty: publisher setup (rules, payout wallet, scan) only from this machine. Set: required as X-Owner-Token header
PUBLISHER_OWNER_TOKEN=
GATEWAY_PUBLIC_URL=http://localhost:8000/
PUBLISHER_NAME=Demo Research Firm
DB_PATH=finhack.db
# At least 32 characters: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SESSION_TTL_SECONDS=900
OFFER_TTL_SECONDS=300
KYA_CHALLENGE_TTL_SECONDS=120
RECEIPT_TTL_HOURS=24
QUERY_RATE_LIMIT_PER_MIN=30
KYA_BLOCKLIST=0xBLOCKED_WALLET_FOR_DEMO
DAILY_SECTION_LIMIT=3
MAX_NEGOTIATION_ROUNDS=3
CORS_ORIGINS=http://localhost:3000

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
SALES_AGENT_EFFORT=low
RULES_PARSER_EFFORT=medium

# Simulated site
DEMO_SITE_URL=

# Local development only: let the scan reach a site on localhost (site-demo/serve.py)
SCAN_ALLOW_PRIVATE_HOSTS=

# Compliance (docs/SECURITY_AND_COMPLIANCE.md)
# Sanctions screening: Chainalysis oracle (OFAC SDN) read on Ethereum mainnet. "off" = local blocklist only.
SANCTIONS_ORACLE=0x40C57923924B5c5c5455c48D93317139ADDaC8fb
SANCTIONS_RPC_URL=https://ethereum-rpc.publicnode.com
# open | closed when the oracle cannot be read. Default: closed on Base mainnet, open on testnet.
SANCTIONS_FAIL_MODE=
# Personal data (missions, buyer messages, LLM replies) erased after this many days. Payment records are kept.
PERSONAL_DATA_RETENTION_DAYS=30
# Publisher key that signs the manifest and the license receipts. Prefer the keystore form.
# Empty: one is created once in .publisher_signing_key (mode 600, git-ignored).
PUBLISHER_SIGNING_KEY=
PUBLISHER_SIGNING_KEY_KEYSTORE=
# Secret for the per-buyer watermark ids (defaults to JWT_SECRET)
WATERMARK_SECRET=
# Owner token rotation: PUBLISHER_OWNER_TOKEN may hold "new,old"; tokens are refused after this date (UTC)
PUBLISHER_OWNER_TOKEN_EXPIRES_AT=
BUYER_OWNER_TOKEN_EXPIRES_AT=
# Encrypted buyer keys (scripts/encrypt_keys.py): BUYER_PRIVATE_KEY_1_KEYSTORE=keys/BUYER_PRIVATE_KEY_1.json,
# password in the macOS Keychain (service "doubloon"), or KEYSTORE_PASSWORD where there is no Keychain.
KEYSTORE_PASSWORD=

# Buyer velocity limits (per wallet, across runs) and manifest trust
BUYER_MAX_PER_DAY_USDC=25.00
BUYER_MAX_TX_PER_HOUR=20
BUYER_STRUCTURING_COUNT=3
# Comma-separated publisher signer addresses to trust explicitly (else trust on first use, then pinned)
BUYER_TRUSTED_SIGNERS=
# 1 = refuse unsigned manifests even on first contact (default 1 on Base mainnet)
BUYER_REQUIRE_SIGNED_MANIFEST=
