# Gateway base URL. Leave empty to run every screen on mock data.
NEXT_PUBLIC_GATEWAY_URL=
# Force mock data even when a gateway URL is set.
NEXT_PUBLIC_USE_MOCKS=false

NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_DEMO_SITE_URL=
# Public address of the buyer agent wallet shown in the live view (never a private key).
NEXT_PUBLIC_BUYER_WALLET=
